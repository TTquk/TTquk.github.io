<div class="kira-right-column">
	<div class="kira-search" id="kira-search" data-index="<%- url_for('/search.json') %>">
		<button
			class="kira-search-toggle"
			type="button"
			aria-label="站内搜索"
			title="站内搜索（Ctrl + K）"
		>
			<i class="kirafont icon-search"></i>
		</button>
		<div
			class="kira-search-panel"
			role="dialog"
			aria-label="站内搜索"
			aria-hidden="true"
		>
			<div class="kira-search-box">
				<i class="kirafont icon-search"></i>
				<input
					class="kira-search-input"
					type="text"
					placeholder="搜索文章标题或内容…"
					autocomplete="off"
					autocorrect="off"
					spellcheck="false"
					enterkeyhint="search"
					aria-label="搜索关键词"
				/>
				<button class="kira-search-close" type="button" aria-label="关闭搜索">
					<i class="kirafont icon-close"></i>
				</button>
			</div>
			<div class="kira-search-status" id="kira-search-status"></div>
			<div class="kira-search-results" id="kira-search-results"></div>
		</div>
	</div>
	<div class="kira-theme">
		<button
			class="kira-theme-toggle"
			type="button"
			aria-label="切换深色模式"
			title="切换深色 / 浅色（Ctrl + J）"
		>
			<svg class="kira-theme-icon kira-theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
				<circle cx="12" cy="12" r="4.2" />
				<path
					d="M12 2.4v2.3M12 19.3v2.3M2.4 12h2.3M19.3 12h2.3M5.6 5.6l1.6 1.6M16.8 16.8l1.6 1.6M18.4 5.6l-1.6 1.6M7.2 16.8l-1.6 1.6"
				/>
			</svg>
			<svg class="kira-theme-icon kira-theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
				<path d="M20.6 14.4A8.7 8.7 0 0 1 9.6 3.4a8.7 8.7 0 1 0 11 11z" />
			</svg>
		</button>
	</div>
	<a onclick="document.querySelector('#kira-top-header').scrollIntoView({behavior: 'smooth'});" class="kira-backtotop" aria-label="回到顶部" title="回到顶部">
		<button class="mdui-fab mdui-ripple">
			<i class="kirafont icon-caret-up"></i>
		</button>
	</a>
</div>
